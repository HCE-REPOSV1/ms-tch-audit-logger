# ms-tch-audit-logger — Audit Logger Service
# Generado a partir de "BACKUP BACK .ENV/ms-tch-audit-logger/.env" + variables
# agregadas después del backup (AUDIT_API_KEY, AUDIT_PAYLOAD_KEY) + DB_NAME=HCE_AUDIT.
# Ver .env.example para documentación completa de cada variable.

PORT=10400
NODE_ENV=development

# ── Seguridad — API Key HTTP ───────────────────────────────
# Vacío = guard permisivo (modo desarrollo). Establecer en producción.
AUDIT_API_KEY=

# ── Cifrado de payloads — AES-256-GCM (S5) ───────────────
# Vacío = payload_encrypted se guarda como JSON plano (solo desarrollo).
AUDIT_PAYLOAD_KEY=

# ── Kafka ─────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=platform.logs
# Usado solo por docker-compose.dev.yml para el listener externo del broker local
KAFKA_EXTERNAL_HOST=host.docker.internal

# ── SQL Server ────────────────────────────────────────────
# Tablas creadas automáticamente en el primer arranque (synchronize=true en dev)
DB_HOST=host.docker.internal
DB_PORT=1433
DB_USER=claude_mssql
DB_PASS=1234
DB_NAME=HCE_AUDIT
# DB_INSTANCE vacío: la instancia local es SQLEXPRESS (no INST01, default del código)
# y SQL Browser está detenido, así que la conexión debe ir directa por DB_PORT sin
# nombre de instancia (mismo patrón que ms-bs-core-encounter/.env).
DB_INSTANCE=

# ── SSL ───────────────────────────────────────────────────
USE_SSL=true
SSL_PORT=20400
CERT_PATH=/app/certs
CERTS_HOST_PATH=../certs-dev
